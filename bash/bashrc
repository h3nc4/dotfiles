# shellcheck disable=SC2154
export LOADED_BASHRC=1 # Prevents this file from being sourced more than once

# Load variables
. "${HOME}/.config/env"

if [ -n "${VSCODE_RESOLVING_ENVIRONMENT}" ]; then # If in VSCode, return
	return
fi

if shopt -oq posix; then # If POSIX, return
	return
fi

case $- in # Check for an interactive session
*i*) ;;
*) return ;;
esac

# Inside tmux, mark it for any host reached from here, since ssh sends LC_* and sshd accepts it
[ -n "${TMUX}" ] && export LC_TMUX_PARENT=1

# Start tmux at login, unless a tmux is already running here or on the ssh client
if [ -z "${TMUX}" ] && [ -z "${LC_TMUX_PARENT}" ] && [[ "$(tty)" != /dev/tty[123] ]]; then # Starting tmux also clears the console
	exec tmux new-session -s "session-$(\date +'%Y%m%d-%H%M%S-%3N')"
elif [ "$(tty)" != /dev/tty1 ]; then # Clear any messages on ttys but tty1
	clear
fi

start_deamon() {
	if ! pgrep -x "$1" >/dev/null 2>&1; then
		(
			(
				exec setsid "$1" \
					>"${HOME}/.local/$1.log" \
					2>&1 \
					</dev/null
			) &
			exit 0
		)
	fi
}

# If X or Wayland is running, start the audio services
if [ -n "${DISPLAY}" ] || [ -n "${WAYLAND_DISPLAY}" ]; then
	start_deamon pipewire
	start_deamon pipewire-pulse
	start_deamon wireplumber
fi

# Load local profiles
if [ -d "${HOME}/.config/profile.d" ]; then
	for i in "${HOME}/.config/profile.d/"*; do . "${i}"; done
fi
unset i

# Load aliases
. "${HOME}/.config/bash/aliases"
# Load functions
. "${HOME}/.config/bash/functions"
# Load Keybinds
. "${HOME}/.config/bash/keybinds"

uid="$(id -u)"
if [ ! -d "${XDG_RUNTIME_DIR}" ] || [ "$(stat -c '%u' "${XDG_RUNTIME_DIR}" 2>/dev/null)" -ne "${uid}" ]; then
	doas mkdir -p "${XDG_RUNTIME_DIR}"
	doas chown "${uid}:${uid}" "${XDG_RUNTIME_DIR}"
	doas chmod 0700 "${XDG_RUNTIME_DIR}"
fi

# Own the session bus, otherwise a client autolaunches one and writes ~/.dbus
[ -S "${XDG_RUNTIME_DIR}/bus" ] || dbus-daemon --session \
	--address="unix:path=${XDG_RUNTIME_DIR}/bus" --fork --syslog-only

SSH_LOCK="${SSH_ENV}.lock"
(
	flock -x 9 || exit 1

	if [ -f "${SSH_ENV}" ]; then
		. "${SSH_ENV}" >/dev/null
		if [ -S "${SSH_AUTH_SOCK}" ] && kill -0 "${SSH_AGENT_PID}" 2>/dev/null; then
			exit 0
		fi
	fi
	umask 077
	ssh-agent -s >"${SSH_ENV}"
) 9>"${SSH_LOCK}"
. "${SSH_ENV}" >/dev/null

setsid gpg-connect-agent /bye >/dev/null 2>&1 </dev/null # Start gpg-agent

# Start X or Wayland at login but skip if a skip file is present
if [ "$(tty)" = "/dev/tty1" ] && [ ! -f "${HOME}/.config/.skip-x" ]; then
	if [ -f "${HOME}/.config/.wayland" ]; then
		session="dwl"
		lockfile="/tmp/.dwl-lock"
		pipe="/tmp/dwl-status-pipe"
		[ -p "${pipe}" ] || mkfifo "${pipe}"
		.config/wayland/dyn-status >"${pipe}" &
		session_cmd="exec dwl -s \".config/wayland/dyn-wallpapers -s '${WALLPAPER_DIR}/landscape.jpg' <&-\" <\"${pipe}\""
	else
		session="Xorg"
		lockfile="/tmp/.Xinit-lock"
		# XLibre where xlibre-opt installed it, unless a .xorg file asks for Xorg
		xserver="/usr/bin/X"
		[ -x /opt/xlibre/bin/X ] && [ ! -f "${HOME}/.config/.xorg" ] && xserver="/opt/xlibre/bin/X"
		session_cmd="exec startx ~/.config/X11/xinitrc -- ${xserver} vt7"
	fi
	if [ -f "${lockfile}" ]; then
		echo "${session} has restarted. Press Enter to restart ${session}."
		read -r
	fi
	touch "${lockfile}"
	pidof "${session}" >/dev/null 2>&1 || eval "${session_cmd}"
fi

# Setup dircolors
command -v dircolors >/dev/null && eval "$(dircolors -b)"

# Enable shell completion features
if [ -f /usr/share/bash-completion/bash_completion ]; then
	. /usr/share/bash-completion/bash_completion
elif [ -f /etc/bash_completion ]; then
	. /etc/bash_completion
fi

# Load command not found handler
command_not_found_handle() {
	if [ -x /usr/share/command-not-found/command-not-found ]; then
		/usr/share/command-not-found/command-not-found -- "$1"
		return $?
	elif [ -x /usr/lib/command-not-found ]; then
		/usr/lib/command-not-found -- "$1"
		return $?
	fi
	printf "%s: command not found\n" "$1" >&2
	return 127
}

export HISTCONTROL='ignoreboth'
export HISTSIZE=''
export HISTFILESIZE=''
export HISTTIMEFORMAT='%F %T '
export HISTFILE="${XDG_DATA_HOME}/bash_history"
shopt -s histappend       # append to history, don't overwrite it
shopt -s checkwinsize     # check the window size after each command
shopt -s globstar         # understand ** as all files in all subdirectories
shopt -s dotglob          # also include hidden files in globbing
complete -cf doas         # complete doas commands
complete -F _command doas # complete doas commands

# Set the prompt
PROMPT_COMMAND="build_prompt"
build_prompt() {
	local ref
	ref=$(git branch --show-current 2>/dev/null || :)
	# PS1="${RESET}[\A/\u \W]${ref:+($ref)}\$ " # uncomment for no color
	# shellcheck disable=SC2154
	PS1="${BOLD}${RED}[${GREEN}\A${BLUE}/${CYAN}\u ${YELLOW}\W${RED}]${WHITE}${ref:+(${RED}${ref}${WHITE})}\$ ${RESET}"
}

# Welcome message, from a cache per user so one user's file never blocks another's refresh
FILE="${XDG_CACHE_HOME:-${HOME}/.cache}/bible.qotd"
if [ -s "${FILE}" ]; then
	echo -e "\033[1mWelcome ${USER}.\nToday is $(\date '+%A, %B %d, %Y').\n\n\033[0m$(cat "${FILE}")\033[1m\n"
else
	echo -e "\033[1mWelcome ${USER}.\nToday is $(\date '+%A, %B %d, %Y').\n"
fi

# If file doesn't exist or is older than 60 minutes, fetch a new quote of the day
(if ! { [ -s "${FILE}" ] && find "${FILE}" -mmin -60 -quit >/dev/null 2>&1; }; then
	command -v bibverse >/dev/null || exit 0
	mkdir -p "${FILE%/*}"
	exec 9>"${FILE}.lock"
	flock -n 9 || exit 0
	VERSE="$(bibverse)" || exit 0
	printf '%s\n' "${VERSE}" | sed 's/ — /\n\t- /' >"${FILE}"
fi) >/dev/null 2>&1 &
disown

# Remove annoying folders
rm -rf "${HOME}/.pki"
rmdir "${HOME}/Downloads" 2>/dev/null
