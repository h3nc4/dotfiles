#!/bin/sh

if [ "$(id -un)" = "steam" ]; then
	exec "/usr/games/steam"
fi

if ! getfacl -p "${XDG_RUNTIME_DIR}" 2>/dev/null | grep -q "^user:steam:rwx"; then
	doas setfacl -m "u:steam:rwx" "${XDG_RUNTIME_DIR}"
fi

if [ -d "${XDG_RUNTIME_DIR}/pulse" ]; then
	if ! getfacl -p "${XDG_RUNTIME_DIR}/pulse" 2>/dev/null | grep -q "^user:steam:rwx"; then
		doas setfacl -R -m "u:steam:rwx" "${XDG_RUNTIME_DIR}/pulse"
	fi
fi

exec doas -u "steam" env \
	DISPLAY=:0 \
	XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" \
	PIPEWIRE_REMOTE=pipewire-0 \
	PULSE_SERVER="unix:${XDG_RUNTIME_DIR}/pulse/native" \
	__NV_PRIME_RENDER_OFFLOAD=1 \
	__GLX_VENDOR_LIBRARY_NAME=nvidia \
	/opt/minecraft-launcher/minecraft-launcher
